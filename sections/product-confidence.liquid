{{ 'section-product-confidence.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if section.settings.heading != blank or section.settings.text != blank or section.blocks.size > 0 -%}
  <div class="product-confidence color-{{ section.settings.color_scheme }} gradient">
    <div class="product-confidence__inner page-width section-{{ section.id }}-padding">
      {%- if section.settings.heading != blank or section.settings.text != blank -%}
        <div class="product-confidence__header">
          {%- if section.settings.heading != blank -%}
            <h2 class="product-confidence__heading title inline-richtext h1">
              {{ section.settings.heading }}
            </h2>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <div class="product-confidence__intro rte">
              {{ section.settings.text }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul
          class="product-confidence__list product-confidence__list--{{ section.blocks.size }} list-unstyled"
          role="list"
        >
          {%- for block in section.blocks -%}
            <li class="product-confidence__item" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <div class="product-confidence__icon" aria-hidden="true">
                  {{
                    block.settings.image
                    | image_url: width: 120
                    | image_tag:
                      widths: '30, 60, 90, 120',
                      sizes: '30px',
                      loading: 'lazy',
                      class: 'product-confidence__icon-image',
                      alt: ''
                  }}
                </div>
              {%- endif -%}

              <div class="product-confidence__content">
                {%- if block.settings.heading != blank -%}
                  <h3 class="product-confidence__item-heading h4 inline-richtext">
                    {{ block.settings.heading }}
                  </h3>
                {%- endif -%}

                {%- if block.settings.text != blank -%}
                  <div class="product-confidence__text rte">
                    {{ block.settings.text }}
                  </div>
                {%- endif -%}

                {%- if block.settings.link_label != blank -%}
                  <a
                    {% if block.settings.link == blank %}
                      role="link"
                      aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.link }}"
                    {% endif %}
                    class="product-confidence__link link animate-arrow"
                  >
                    {{- block.settings.link_label | escape -}}
                    <span class="svg-wrapper">
                      {{- 'icon-arrow.svg' | inline_asset_content -}}
                    </span>
                  </a>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product confidence",
  "tag": "section",
  "class": "section section-product-confidence",
  "enabled_on": {
    "templates": ["product"]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Purchase information"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction",
      "default": "<p>Review the available information before placing your order.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Confidence item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon image"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Information"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Add details for this item.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product confidence",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "heading": "Shipping information",
            "text": "<p>Review the available shipping information before placing your order.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "heading": "Returns information",
            "text": "<p>Review the applicable return information for this product.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "heading": "Payment information",
            "text": "<p>Review the available payment methods during checkout.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
